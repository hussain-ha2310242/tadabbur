# Server-side settings for the Netlify functions. Put them in Netlify >
# Site configuration > Environment variables (or a local .env for `netlify dev`).
# Never give them a VITE_ prefix: those are built into the public page.

# required: Fanar (word analysis, translations, word cards, audio)
FANAR_API_KEY=

# optional: Supabase secret key (Project settings > API keys). With it, word
# analyses, translations and audio are kept and shared instead of paid for again.
SUPABASE_SECRET_KEY=

# optional: the default reading voice (Noor, Huda, Jasim, Hamad, Abdulrahman)
FANAR_TTS_VOICE=Noor
